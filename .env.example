# DISCORD_TOKEN: Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN="ton_token_de_bot_ici"

# CLIENT_ID: Discord Application ID
CLIENT_ID="ton_client_id_ici"

# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL
APP_URL="MY_APP_URL"
PORT=3000
